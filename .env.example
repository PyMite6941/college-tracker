# College Tracker - stored credentials
# Copy this file to .env and fill in real values before running.
# .env is gitignored - never commit real credentials.

# Example college portal (registrar / registration checklist)
COLLEGE_LOGIN_URL=https://example-college.edu/login
COLLEGE_CHECKLIST_URL=https://example-college.edu/student/registration-checklist
COLLEGE_USER=your_username_here
COLLEGE_PASS=your_password_here

# Add more sites below using the same prefix pattern, then add an entry
# to sites.json pointing user_env/pass_env at these variables.

# Playwright: set to "false" to watch the browser run (useful for debugging)
PLAYWRIGHT_HEADLESS=true

# Chrome profile for password-manager integration (optional).
# Set this to your Chrome User Data directory so Playwright can reuse
# Chrome's saved passwords / autofill. On Windows:
#   C:\Users\<you>\AppData\Local\Google\Chrome\User Data
# Then add chrome_profile: "Default" to a site in sites.json,
# or select a profile via the web UI at /sites.
CHROME_USER_DATA_DIR=
CHROME_PROFILE=

# Credentials for each site are saved to credentials.toml (gitignored)
# via the "Save creds" button on the /sites page. .env variables are
# only used as a fallback when credentials.toml doesn't have an entry.

# Flask
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
