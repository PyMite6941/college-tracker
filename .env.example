# College Tracker settings. Copy to .env (gitignored) and edit.
# Restart the app after changing anything here.

# --- Web UI (local only) ------------------------------------------------
HOST=127.0.0.1          # loopback only; anything else needs ALLOW_REMOTE=1 (not recommended)
PORT=5000
FLASK_DEBUG=0           # 1 enables the Werkzeug debugger - never with ALLOW_REMOTE
# FLASK_SECRET_KEY=     # optional; a random key is generated in data/.secret_key

# --- Checks ---------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true   # false = watch checks run in a visible browser
ALLOW_LOCAL_TARGETS=0      # 1 = allow checks of localhost/private-network pages (testing)
SESSION_MAX_AGE_DAYS=14    # saved sign-ins older than this are flagged for re-sign-in
CHECK_TIMEOUT_MS=30000

# --- History & alerts -------------------------------------------------------
HISTORY_MAX_RUNS=50        # runs kept per check
HISTORY_MAX_DAYS=90        # 0 = keep forever

# --- Notifications (off unless NOTIFY_WEBHOOK_URL is set) -------------------
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-private-topic
# NOTIFY_FORMAT=ntfy       # json | discord | slack | ntfy
# NOTIFY_ON=change,watch,reauth,error,reminder,email

# --- Credentials --------------------------------------------------------------
# Where saved passwords live: "file" (plain text in credentials.toml, default)
# or "keyring" (Windows Credential Manager / macOS Keychain / Secret Service).
# After changing it, run `python run.py secure` to move existing passwords.
CREDENTIAL_STORE=file
# Preferred: sign in yourself ("Sign in" on the Sites page) or save a
# username/password per site from the web UI (stored in credentials.toml,
# gitignored). .env variables are only a fallback for sites.json entries that
# name user_env / pass_env, for example:
# COLLEGE_USER=you@example.edu
# COLLEGE_PASS=change-me

# --- Chrome profile (optional) ------------------------------------------------
# Run checks inside a Chrome profile to reuse its saved passwords/sign-ins.
# Chrome must be closed while checks run. Usually set from the Sites page.
CHROME_USER_DATA_DIR=
CHROME_PROFILE=

# --- College email (optional; easier to set on the Email -> Filters & setup page) ---
# Read-only IMAP sync. Use an app password, never your main password.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=you@example.com
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# EMAIL_SYNC_DAYS=60
